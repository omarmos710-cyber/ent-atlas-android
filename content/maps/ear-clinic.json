   "name": "Earache",
   "c": "blue",
   "icon": "nerve",
   "subs": [
    [
     "Two kinds",
     [
      "primary: ear abnormal on otoscopy",
      "referred: normal ear, ~half of adults"
     ]
    ],
    [
     "Five nerves",
     [
      "V: teeth, jaw joint (commonest)",
      "VII: concha, herpes zoster",
      "IX: tonsil, tongue base, styloid",
      "X: larynx, hypopharynx",
      "C2, C3: cervical spine"
     ]
    ],
    [
     "Red flags",
     [
      "smoker + normal ear → scope the throat",
      "necrotising otitis externa: diabetic, elderly",
      "pain before vesicles: Ramsay Hunt"
     ]
    ],
    [
     "Referred causes",
     [
      "jaw joint: chewing pain, clicking, splint",
      "Eagle: long styloid",
      "neuralgias: carbamazepine first"
     ]
    ],
    [
     "Pearl",
     [
      "post-tonsillectomy earache = referred"
     ]
    ]
   ]
  },
  {
   "id": "ap_otorr",
   "name": "Discharging ear",
   "c": "orange",
   "icon": "drop",
   "subs": [
    [
     "Read it",
     [
      "mucoid = middle ear open",
      "scanty, foul = cholesteatoma",
      "fungal debris = otomycosis",
      "watery after head injury = CSF"
     ]
    ],
    [
     "Clean first",
     [
      "microsuction under the microscope",
      "can't clean → wick + drops, review",
      "test the facial nerve every time"
     ]
    ],
    [
     "Red flags",
     [
      "blood, persistent granulation → biopsy",
      "palsy, vertigo, headache → complication"
     ]
    ],
    [
     "Treat",
     [
      "otitis externa: drops 7–10 days",
      "fungal: clotrimazole two to three weeks",
      "open drum: quinolone drops",
      "cholesteatoma: surgery, not drops"
     ]
    ],
    [
     "Not settling",
     [
      "after two courses of drops",
      "swab · biopsy · CT",
      "consider tuberculosis"
     ]
    ]
   ]
  },
  {
   "id": "ap_full",
   "name": "Blocked ear",
   "c": "green",
   "icon": "drum",
   "subs": [
    [
     "Four sites",
     [
      "canal · middle ear · tube · cochlea",
      "wax commonest"
     ]
    ],
    [
     "Don't miss",
     [
      "sudden sensorineural loss: test today",
      "adult unilateral effusion → nasopharynx",
      "low-frequency loss + vertigo → Ménière's"
     ]
    ],
    [
     "Forks first",
     [
      "Weber to it + Rinne negative = conductive",
      "Weber away + Rinne positive = sensorineural"
     ]
    ],
    [
     "The tube",
     [
      "obstructive: improves when ear pops",
      "patulous: autophony, better lying down",
      "balloon dilation: select by ETDQ-7",
      "no decongestants for patulous"
     ]
    ],
    [
     "Third window",
     [
      "autophony, sound or pressure vertigo",
      "apparent conductive loss, reflexes kept"
     ]
    ]
   ]
  },
  {
