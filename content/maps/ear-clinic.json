   "name": "Ear operations",
   "c": "purple",
   "icon": "scalpel",
   "subs": [
    [
     "Priorities",
     [
      "safe → dry → hearing",
      "never repair a wet ear"
     ]
    ],
    [
     "Grommets",
     [
      "posteroinferior to drain pus",
      "anteroinferior for effusion",
      "look for a high jugular bulb"
     ]
    ],
    [
     "Drum repair",
     [
      "myringoplasty: drum only",
      "underlay vs overlay",
      "cartilage take 92% vs fascia 82%"
     ]
    ],
    [
     "Wullstein",
     [
      "I malleus · II incus · III stapes",
      "IV footplate · V fixed footplate"
     ]
    ],
    [
     "Ossicles",
     [
      "commonest: incus long process eroded",
      "PORP on stapes beats TORP"
     ]
    ],
    [
     "Mastoid",
     [
      "cortical: canal wall kept",
      "modified radical: working ossicles kept",
      "radical: loss ≥ 50 dB"
     ]
    ]
   ]
  },
