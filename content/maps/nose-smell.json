 "cards": [
  {
   "st": "watery",
   "art": "ap_epiph",
   "c": "purple",
   "row": "top",
   "zone": 0,
   "t": "Watering eye",
   "tag": "interchange",
   "why": "Tears overflow because too many are made or too few drain away.",
   "see": [
    "dry eye: up to 40% of referrals",
    "lid pump fails: facial palsy, lax lid"
   ],
   "warn": "Bloody reflux or a firm mass above the canthal tendon: sac tumour."
  },
  {
   "st": "syr",
   "art": "ap_epiph",
   "c": "purple",
   "row": "top",
   "zone": 0,
   "t": "Syringing: find the level",
   "see": [
    "free flow: system patent",
    "reflux same punctum: canalicular",
    "reflux opposite punctum: duct",
    "dye test: retained at five minutes"
   ]
  },
  {
   "st": "dcr",
   "art": "ap_epiph",
   "c": "purple",
   "row": "top",
   "zone": 1,
   "t": "DCR",
   "why": "Opens the lacrimal sac into the nose, bypassing a blocked nasolacrimal duct.",
   "see": [
    "duct ~12 mm, opens under inferior turbinate",
    "sac: in front of the middle turbinate",
    "infants: ~20% imperforate Hasner's valve"
   ],
   "do": [
    "endonasal: about 90% success",
    "infants: massage, most clear by one year"
   ],
   "warn": "Fails if too small or too high. Not for dry eye or canalicular block."
  },
  {
   "st": "smell",
   "art": "ap_smell",
   "c": "blue",
   "row": "top",
   "zone": 1,
   "t": "Smell loss",
   "tag": "interchange",
   "why": "Conductive: odours cannot reach the cleft. Sensorineural: the receptors or their pathways are damaged.",
   "see": [
    "fluctuating, steroid-responsive: conductive",
    "sudden after virus or injury: sensorineural",
    "lost \"taste\" is usually lost smell"
   ],
   "do": [
    "endoscope the olfactory clefts",
    "measure it: UPSIT, Sniffin' Sticks",
    "below chance: consider non-organic"
   ],
   "warn": "Unilateral loss with blockage or bleeding: sinonasal tumour."
  },
  {
   "st": "air",
   "art": "nphys",
   "c": "orange",
   "row": "top",
   "zone": 1,
   "t": "Air conditioning",
   "why": "In about a quarter of a second the nose warms, humidifies and filters each breath.",
   "see": [
    "humidity raised to 75% or more",
    "air at 0°C nearly at body heat",
    "mucus traps particles to ~0.5 µm"
   ],
   "warn": "Packing both sides lowers oxygen tension."
  },
  {
   "st": "cleft",
   "art": "ap_smell",
   "c": "blue",
   "row": "top",
   "zone": 2,
   "t": "Olfactory cleft",
   "why": "Polyps or oedema can block the clefts when the rest of the nose looks normal.",
   "see": [
    "CRS with polyps: commonest cause in clinic"
   ],
   "do": [
    "steroid drops, head-down",
    "short oral steroid tests reversibility",
    "surgery or biologics for polyps"
   ]
  },
  {
   "st": "sens",
   "art": "ap_smell",
   "c": "blue",
   "row": "top",
   "zone": 3,
   "t": "Sensorineural loss",
   "see": [
    "post-viral, including COVID-19",
    "head injury: fibres shear at the cribriform",
    "parosmia: often regeneration"
   ],
   "do": [
    "olfactory training: four odours, twice a day",
    "for at least three to six months",
    "smoke and gas alarms, food dates"
   ],
   "warn": "After head injury only about 10% recover fully."
  },
  {
   "st": "park",
   "art": "ap_smell",
   "c": "blue",
   "row": "top",
   "zone": 4,
   "t": "Brain red flags",
   "see": [
    "Parkinson's: about 90% at diagnosis",
    "brief phantosmia: temporal lobe seizures",
    "lifelong + delayed puberty: Kallmann",
    "headache, personality change: meningioma"
   ],
   "do": [
    "MRI: unexplained or unilateral loss"
   ]
  },
  {
   "st": "blanket",
   "art": "nphys",
   "c": "orange",
   "row": "bottom",
   "zone": 1,
   "t": "Mucous blanket",
   "why": "Cilia beat in the thin serous layer and carry the mucus sheet to the nasopharynx.",
   "see": [
    "10 to 20 beats a second",
    "5 to 10 mm a minute",
    "saccharin tasted within ~20 minutes",
    "cilia stop at 50% humidity"
   ]
  },
  {
   "st": "bulb",
   "art": "nphys",
   "c": "orange",
   "row": "bottom",
   "zone": 3,
   "t": "Olfactory pathway",
   "why": "Olfactory receptor neurons regenerate throughout life.",
   "see": [
    "epithelium: cribriform plate, upper septum",
    "bulb → tract → piriform cortex",
    "flavour = taste + smell"
   ],
   "do": [
    "no ammonia: it tests the trigeminal"
   ]
  },
  {
   "st": "crust",
   "art": "ap_crust",
   "c": "green",
   "row": "bottom",
   "zone": 0,
   "w": 1,
   "t": "Nasal crusting",
   "tag": "interchange",
   "why": "Mucus dries faster than it is cleared: scarred mucosa, fast or turbulent airflow, failed cilia or inflammation.",
   "see": [
    "cocaine: perforation, palatal defect",
    "one-sided ulcer or mass: lymphoma, carcinoma",
    "saddle nose: GPA, cocaine"
   ],
   "do": [
    "saline irrigation for everyone",
    "ANCA, ACE, calcium, urinalysis",
    "biopsy the active edge, not crusts"
   ],
   "warn": "Levamisole in cocaine can turn ANCA positive."
  },
  {
   "st": "edge",
   "art": "gpa",
   "c": "green",
   "row": "bottom",
   "zone": 1,
   "t": "Biopsy, always",
   "why": "Many are systemic diseases showing in the nose; none can be named without a biopsy.",
   "see": [
    "TB, lupus, leprosy: cartilaginous septum",
    "syphilis: bony septum",
    "rhinosporidiosis: strawberry mass, white dots"
   ],
   "do": [
    "look at chest, kidneys, eyes, skin, nodes"
   ]
  },
  {
   "st": "scler",
   "art": "gpa",
   "c": "green",
   "row": "bottom",
   "zone": 1,
   "t": "Rhinoscleroma",
   "why": "Klebsiella rhinoscleromatis spreads from the nose down to the larynx and trachea.",
   "see": [
    "atrophic → granulomatous → cicatricial",
    "woody Hebra nose",
    "Mikulicz cells + Russell bodies"
   ],
   "do": [
    "antibiotics until two cultures negative"
   ]
  },
  {
   "st": "gpa",
   "art": "gpa",
   "c": "green",
   "row": "bottom",
   "zone": 2,
   "w": 1.3,
   "t": "Granulomatosis with polyangiitis",
   "tag": "interchange",
   "why": "A necrotising granulomatous vasculitis of small vessels: upper airway, lungs and kidneys.",
   "see": [
    "crusting, perforation, saddle nose",
    "c-ANCA (PR3) in most active disease",
    "urinalysis + creatinine: the kidneys"
   ],
   "do": [
    "steroids + rituximab or cyclophosphamide",
    "rebuild only when quiescent"
   ],
   "warn": "Untreated, glomerulonephritis is the usual cause of death."
  },
  {
   "st": "lymph",
   "art": "gpa",
   "c": "red",
   "row": "bottom",
   "zone": 3,
   "t": "NK/T-cell lymphoma",
   "why": "A cancer that looks like inflammation, linked to EBV.",
   "see": [
    "relentless midline destruction"
   ],
   "do": [
    "deep, repeated biopsies + EBV studies",
    "radiotherapy with chemotherapy"
   ],
   "warn": "Superficial biopsies show only necrosis."
  }
 ],
