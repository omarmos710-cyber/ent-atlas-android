     "Cavernous sinus",
     [
      "III, IV, V1, V2 in lateral wall",
      "VI free beside ICA → fails first"
     ]
    ],
    [
     "Pterygopalatine",
     [
      "opens to orbit, nose, mouth, cranium",
      "crossroads for perineural spread"
     ]
    ],
    [
     "Parapharyngeal",
     [
      "prestyloid: pleomorphic adenoma",
      "poststyloid: schwannoma, paraganglioma",
      "tonsil pushed medially",
      "never transoral biopsy"
     ]
    ],
    [
     "Red flags",
     [
      "adult unilateral effusion → nasopharynx",
      "V2/V3 numbness = perineural spread",
      "chordoma midline · chondrosarcoma off it"
     ]
    ],
    [
     "Reconstruct",
     [
      "multilayer: inlay + onlay + flap",
      "nasoseptal flap: leaks > 20% → ~5%"
     ]
    ]
   ]
  },
  {
   "id": "juv",
   "name": "Angiofibroma",
   "c": "red",
   "icon": "vessel",
   "subs": [
    [
     "Who",
     [
      "adolescent boy, 10–20 years",
      "epistaxis + obstruction",
      "testosterone-dependent"
     ]
    ],
    [
     "Spread",
     [
      "origin: sphenopalatine foramen",
      "PPF → infratemporal fossa, orbit",
      "intracranial in 20–25%"
     ]
    ],
    [
     "Diagnose",
     [
      "contrast CT: antral (Holman-Miller) sign",
      "MRI flow voids: salt and pepper",
      "never biopsy in clinic"
     ]
    ],
    [
     "Treat",
     [
      "embolise, operate within 24–48 h",
      "endoscopic resection for most",
      "radiotherapy if unresectable",
      "hormones no longer used"
     ]
    ],
    [
     "Recurrence",
     [
      "up to a third, within two years",
      "vidian canal, basisphenoid: drill",
      "MRI follow-up ≥ three years"
     ]
    ]
   ]
  },
  {
   "id": "pituitary",
   "name": "Pituitary",
   "c": "purple",
   "icon": "gland",
   "subs": [
    [
     "Relations",
     [
      "chiasm above → bitemporal hemianopia",
      "intersinus septum may insert on ICA",
      "Onodi cell carries optic nerve"
     ]
    ],
    [
     "Adenoma",
     [
      "micro < 10 mm, macro ≥ 10 mm",
      "prolactinoma commonest functioning",
      "stalk effect: prolactin usually < 200"
     ]
    ],
    [
     "Treat",
     [
      "prolactinoma → cabergoline, even field loss",
      "GH, ACTH, TSH adenomas → surgery",
      "endoscopic endonasal, two surgeons"
     ]
    ],
    [
     "Apoplexy",
     [
      "thunderclap headache, visual loss",
      "IV hydrocortisone at once"
     ]
    ],
    [
     "After surgery",
     [
      "DI: dilute urine, sodium > 145",
      "SIADH: low sodium ~ a week later",
      "steroid cover; no nose blowing"
     ]
    ]
   ]
  },
  {
