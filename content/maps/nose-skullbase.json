   "name": "CSF leak",
   "c": "blue",
   "icon": "drop",
   "subs": [
    [
     "Causes",
     [
      "trauma ~80%",
      "surgery: lateral lamella",
      "spontaneous: IIH, empty sella"
     ]
    ],
    [
     "Clues",
     [
      "clear, one-sided, on bending forward",
      "can't be sniffed back",
      "halo sign hints, doesn't prove"
     ]
    ],
    [
     "Confirm, locate",
     [
      "beta-2 transferrin = the test",
      "glucose unreliable",
      "HRCT first, then T2 MRI",
      "intrathecal fluorescein at surgery"
     ]
    ],
    [
     "Treat",
     [
      "most traumatic close in one to two weeks",
      "bed rest head up, acetazolamide",
      "no prophylactic antibiotics; vaccinate",
      "endoscopic repair > 90% first time"
     ]
    ],
    [
     "Spontaneous",
     [
      "treat raised pressure or it recurs"
     ]
    ]
   ]
  }
