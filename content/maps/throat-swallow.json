   "icon": "question",
   "subs": [
    [
     "Where?",
     [
      "oropharyngeal: can't start, cough, wet voice",
      "oesophageal: sticks after, behind sternum",
      "solids → liquids = mechanical",
      "liquids from the start = motility"
     ]
    ],
    [
     "Red flags",
     [
      "progressive, weight loss → urgent OGD",
      "NICE NG12: OGD within two weeks",
      "hoarse, otalgia, neck lump → head & neck",
      "can't swallow saliva = bolus emergency"
     ]
    ],
    [
     "Examine",
     [
      "flexible endoscopy: piriform pooling",
      "cranial nerves · trial swallow of water"
     ]
    ],
    [
     "Tests",
     [
      "FEES / videofluoroscopy: oropharyngeal",
      "barium: pouch, web, ring, stricture",
      "OGD: oesophageal + red flags",
      "HRM: motility (Chicago)"
     ]
    ],
    [
     "Manage",
     [
      "SLT first: is oral intake safe?",
      "texture, chin tuck, head turn",
      "NG or gastrostomy if unsafe",
      "stroke = commonest oropharyngeal cause"
     ]
    ]
   ]
  },
  {
   "id": "ap_globus",
   "name": "Globus",
   "c": "orange",
   "icon": "throat",
   "subs": [
    [
     "Typical",
     [
      "midline, cricoid / thyroid notch",
      "between meals, eased by eating",
      "no pain, no true dysphagia",
      "worse with stress, throat clearing"
     ]
    ],
    [
     "Not globus if",
     [
      "pain, odynophagia, otalgia",
      "dysphagia, weight loss",
      "unilateral or progressive",
      "hoarse, haemoptysis, neck lump",
      "smoker or drinker over 50"
     ]
    ],
    [
     "Assess",
     [
      "flexible endoscopy, neck + thyroid",
      "normal → no further tests",
      "no routine barium swallow"
     ]
    ],
    [
     "Treat",
     [
      "explanation = the treatment",
      "sip water instead of clearing",
      "SLT · reflux trial (unproven)",
      "discharge with safety-net"
     ]
    ]
   ]
  },
  {
   "id": "pouch",
   "name": "Pharyngeal pouch",
   "c": "green",
   "icon": "lump",
   "subs": [
    [
     "What",
     [
      "pulsion through Killian's dehiscence",
      "thyropharyngeus above, cricopharyngeus below",
      "elderly, over sixty, men > women"
     ]
    ],
    [
     "Features",
     [
      "dysphagia after a few swallows",
      "gurgling · left neck swelling",
      "undigested food hours later",
      "nocturnal cough, aspiration, halitosis"
     ]
    ],
    [
     "Diagnose",
     [
      "barium swallow, lateral view",
      "sac at C5–C6 behind oesophagus",
      "blind rigid scope → perforation",
      "carcinoma in about 1%"
     ]
    ],
    [
     "Treat",
     [
      "endoscopic stapling: commonest",
      "small (< 2–3 cm): laser or open",
      "open: always cricopharyngeal myotomy",
      "myotomy treats the cause"
     ]
    ],
    [
     "CP dysfunction",
     [
      "bar in a third without symptoms",
      "dilatation · botulinum · myotomy"
     ]
    ]
   ]
  },
  {
   "id": "oesoph",
   "name": "Oesophagus",
   "c": "red",
   "icon": "flame",
   "subs": [
    [
     "Narrowings",
     [
      "15 cm cricopharyngeus (C6)",
      "25 cm aortic arch + left bronchus",
      "40 cm hiatus (T10)",
      "foreign bodies lodge, scopes perforate"
     ]
    ],
    [
     "Achalasia",
     [
      "aperistalsis + LOS won't relax",
      "bird's beak · HRM gold standard",
      "exclude pseudoachalasia (cardia cancer)",
      "dilatation, Heller myotomy, POEM"
     ]
    ],
    [
     "Reflux & EoE",
     [
      "Barrett's: salmon-pink → adenocarcinoma",
      "EoE: young atopic man + bolus",
      "≥ 15 eosinophils/HPF"
     ]
    ],
    [
     "Webs & rings",
     [
      "Plummer–Vinson: iron deficiency + web",
      "postcricoid cancer risk",
      "Schatzki < 13 mm → steakhouse"
     ]
    ],
    [
     "Cancer",
     [
      "progressive dysphagia + weight loss",
      "SCC upper/middle · adeno distal",
      "hoarse = RLN · cough on swallow = TOF",
      "five-year survival ~15–20%"
     ]
    ]
   ]
  },
  {
   "id": "fbfood",
   "name": "Swallowed objects",
   "c": "purple",
   "icon": "needle",
   "subs": [
    [
     "Where",
     [
      "~70% at or below cricopharyngeus",
      "fish bones: tonsil, tongue base",
      "low in an adult → underlying cause"
     ]
    ],
    [
     "Films",
     [
      "oesophageal coin: flat on PA",
      "battery: halo on PA, step on lateral",
      "bones often invisible → CT",
      "never barium first"
     ]
    ],
    [
     "Timing",
     [
      "battery: out ideally within two hours",
      "honey 10 ml every 10 min (> 1 year)",
      "sharp, drooling, perforation: hours",
      "other oesophageal objects < 24 h"
     ]
    ],
    [
     "Methods",
     [
      "rigid scope: sharp, ensheath the point",
      "flexible: bolus, blunt objects",
      "no Foley, no blind push, no papain"
     ]
    ],
    [
     "Danger",
     [
      "pain, fever, emphysema = perforation",
      "aorto-oesophageal fistula: sentinel bleed"
     ]
    ]
   ]
  }
