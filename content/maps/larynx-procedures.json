   "name": "Shared airway",
   "c": "blue",
   "icon": "sleep",
   "subs": [
    [
     "Why it matters",
     [
      "NAP4: ~two in five in head and neck",
      "CICO: ~a quarter of anaesthetic deaths"
     ]
    ],
    [
     "Plan together",
     [
      "primary + backup plans before induction",
      "mark the membrane (ultrasound)",
      "surgeon scrubbed, neck prepared"
     ]
    ],
    [
     "Obstructed",
     [
      "awake fibreoptic intubation",
      "inhalational induction, keeps breathing",
      "IV induction only if tube easy"
     ]
    ],
    [
     "Sharing",
     [
      "microlaryngeal tube 5.0–6.0 mm",
      "jet: needs a clear exit (barotrauma)",
      "high-flow nasal oxygen ~70 L/min"
     ]
    ],
    [
     "Bleeding tonsil",
     [
      "more hypovolaemic than they look",
      "resuscitate first · stomach full of blood",
      "RSI · two suctions · smaller tube",
      "extubate awake, on the side"
     ]
    ],
    [
     "Packs · extubation",
     [
      "retained pack = never event",
      "plan extubation like intubation"
     ]
    ]
   ]
  },
  {
   "id": "fona",
   "name": "Neck access · ligation",
   "c": "orange",
   "icon": "scalpel",
   "subs": [
    [
     "CICO",
     [
      "failed tube, SGA and mask, paralysed",
      "declare the emergency out loud",
      "don't repeat failed intubation"
     ]
    ],
    [
     "Landmarks",
     [
      "laryngeal handshake",
      "soft dip just above the cricoid",
      "impalpable: 8–10 cm vertical incision",
      "cut the cricoid → subglottic stenosis"
     ]
    ],
    [
     "Scalpel-bougie-tube",
     [
      "size 10 blade, transverse stab",
      "rotate 90°, edge to the feet",
      "bougie → 6.0 cuffed tube",
      "capnography · tracheostomy by 24–72 h"
     ]
    ],
    [
     "Children < 12",
     [
      "14G cannula + jet oxygen",
      "oxygen, not ventilation: CO2 rises",
      "needs an exit route: barotrauma"
     ]
    ],
    [
     "Artery ligation",
     [
      "sphenopalatine first for epistaxis",
      "24-12-6: ethmoidals → optic nerve",
      "ECA: see ≥ two branches before tying",
      "ECA rebleeds up to ~45%"
     ]
    ]
   ]
  },
  {
   "id": "trach",
   "name": "Tracheostomy",
   "c": "green",
   "icon": "airway",
   "subs": [
    [
     "Does",
     [
      "bypasses obstruction",
      "cuts dead space 30–50%",
      "cuffed tube stops aspiration · suction",
      "TracMan: within four days, no survival gain"
     ]
    ],
    [
     "Level",
     [
      "isthmus over second–fourth rings",
      "never the first ring: subglottic stenosis",
      "high only if laryngectomy likely",
      "low: innominate · thyroid ima ≤ 5%"
     ]
    ],
    [
     "Technique",
     [
      "intubate first · shoulder roll",
      "Björk flap eases reinsertion",
      "confirm with capnography",
      "no tight skin sutures: emphysema",
      "child: stay sutures, no cartilage removed"
     ]
    ],
    [
     "Aftercare",
     [
      "humidify · suction on withdrawal",
      "cuff < ~25–30 cm water",
      "first change after three to five days",
      "decannulate: downsize → cap 24 h"
     ]
    ],
    [
     "Blocked tube",
     [
      "remove valve + inner cannula",
      "catheter won't pass → deflate, remove",
      "oxygenate stoma and face"
     ]
    ],
    [
     "Complications",
     [
      "blockage, displacement = commonest deaths",
      "apnoea after relief of obstruction",
      "innominate fistula < 1%, kills > 80%",
      "sentinel bleed · overinflate cuff"
     ]
    ]
   ]
  },
  {
   "id": "laser",
   "name": "Lasers & energy",
   "c": "red",
   "icon": "laser",
   "subs": [
    [
     "Laser light",
     [
      "stimulated emission, population inversion",
      "monochromatic, coherent, collimated"
     ]
    ],
    [
     "Chromophores",
     [
      "water: CO2 10,600 nm, cuts cleanly",
      "haemoglobin: KTP 532 nm",
      "Nd:YAG coagulates ~4 mm deep"
     ]
    ],
    [
     "Tissue effect",
     [
      "vaporisation · necrosis · repair",
      "focused cuts, defocused coagulates",
      "short pulses < relaxation time"
     ]
    ],
    [
     "Eye safety",
     [
      "goggles matched to wavelength",
      "CO2 burns cornea; visible burns retina",
      "plume carries HPV: evacuator"
     ]
    ],
    [
     "Airway fire",
     [
      "fuel + oxidiser + laser heat",
      "blue saline cuff · O2 ≤ 30% · no N2O",
      "stop laser, gas · tube out · saline",
      "mask air · reintubate · bronchoscopy"
     ]
    ],
    [
     "Other energy",
     [
      "coblation 40–70°C vs diathermy 400–600°C",
      "cryo: freeze fast, thaw slowly",
      "hyperbaric O2: ear barotrauma commonest"
     ]
    ]
   ]
  }
