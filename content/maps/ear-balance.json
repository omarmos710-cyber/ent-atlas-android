   "name": "Approach",
   "c": "blue",
   "icon": "question",
   "subs": [
    [
     "Timing",
     [
      "seconds, positional → BPPV",
      "20 min–12 h + fluctuating ear → Ménière's",
      "5 min–72 h ± headache → migraine",
      "days, continuous → neuritis or stroke",
      "most days > three months → PPPD"
     ]
    ],
    [
     "Red flags",
     [
      "cannot stand or walk unaided",
      "new occipital headache, neck pain",
      "diplopia, dysarthria, dysphagia",
      "changing, vertical or torsional nystagmus"
     ]
    ],
    [
     "HINTS",
     [
      "stroke in ~one in ten acute vertigo",
      "peripheral only if all three agree",
      "normal impulse · changing beat · skew = stroke",
      "beats early MRI in first 48 h",
      "plus: new hearing loss → AICA"
     ]
    ],
    [
     "Vest. migraine",
     [
      "commonest spontaneous recurrent vertigo",
      "≥ five episodes, 5 min–72 h",
      "migrainous feature in ≥ half",
      "no test: clinical · trial prophylaxis"
     ]
    ],
    [
     "Chronic",
     [
      "PPPD: worse upright, busy visual scenes",
      "rehab · CBT · SSRIs",
      "bilateral loss: oscillopsia, dark"
     ]
    ]
   ]
  },
  {
   "id": "vertigo",
   "name": "BPPV · neuritis",
   "c": "orange",
   "icon": "eye",
   "subs": [
    [
     "BPPV",
     [
      "otoconia in a canal: canalolithiasis",
      "posterior canal 85–95%",
      "seconds, on lying down, no hearing loss"
     ]
    ],
    [
     "Dix–Hallpike",
     [
      "torsional upbeat after a latency",
      "< a minute · fatigues · reverses sitting",
      "no latency, no fatigue, vertical = central"
     ]
    ],
    [
     "Reposition",
     [
      "Epley: ~80% one go, > 90% after four",
      "horizontal canal: Lempert barbecue roll",
      "no sedatives · no routine imaging",
      "recurs: up to a third in four years"
     ]
    ],
    [
     "Neuritis",
     [
      "days of vertigo, hearing intact",
      "hearing lost = labyrinthitis",
      "steroids: faster calorics, no clear late gain",
      "BPPV follows in up to 15%"
     ]
    ],
    [
     "Stroke",
     [
      "early MRI misses up to 1 in 5",
      "AICA: + hearing loss, facial palsy",
      "PICA: Wallenberg, dysphagia, Horner"
     ]
    ]
   ]
  },
  {
   "id": "meniere",
   "name": "Ménière's disease",
   "c": "green",
   "icon": "drop",
   "subs": [
    [
     "Hydrops",
     [
      "distended endolymphatic system",
      "vertigo · SNHL · tinnitus · fullness",
      "onset 35–60 years",
      "second ear: up to half in twenty years"
     ]
    ],
    [
     "Definite (2015)",
     [
      "≥ two spontaneous spells, 20 min–12 h",
      "documented low–mid-frequency SNHL",
      "fluctuating aural symptoms, same ear"
     ]
    ],
    [
     "Work-up",
     [
      "audiogram: low-tone rising curve",
      "MRI with contrast: exclude schwannoma",
      "electrocochleography: SP/AP raised",
      "glycerol test: 10 dB gain"
     ]
    ],
    [
     "Ladder",
     [
      "salt 1.5–2 g a day · betahistine trial",
      "BEMED: betahistine = placebo",
      "IT methylprednisolone ≈ gentamicin",
      "gentamicin: control 80–90%, loss 4–30%",
      "dead ear → labyrinthectomy"
     ]
    ],
    [
     "Variants",
     [
      "Lermoyez: hearing improves with vertigo",
      "Tumarkin: drop attacks, conscious"
     ]
    ]
   ]
  },
  {
   "id": "vs",
   "name": "Vestibular schwannoma",
   "c": "red",
   "icon": "nerve",
   "subs": [
    [
     "What",
     [
      "Schwann cells, vestibular nerve, in IAC",
      "~80% of CPA tumours",
      "grows ~1–2 mm a year",
      "bilateral = NF2 (chromosome 22)"
     ]
    ],
    [
     "Presents",
     [
      "one-sided SNHL, discrimination worst",
      "unsteady rather than vertigo",
      "corneal reflex: earliest V sign",
      "Hitselberger's sign (VII)",
      "early facial palsy → another diagnosis"
     ]
    ],
    [
     "Diagnose",
     [
      "MRI + gadolinium = gold standard",
      "roll-over, reflex decay",
      "no LP: herniation"
     ]
    ],
    [
     "Watch",
     [
      "first rescan at six months",
      "grew: 17% canal, 29% extrameatal"
     ]
    ],
    [
     "Treat",
     [
      "radiosurgery 12–13 Gy · control 90–95%",
      "translabyrinthine: any size, deaf",
      "retrosigmoid: hearing may be kept",
      "middle fossa: canal ≤ 1.5 cm"
     ]
    ]
   ]
  },
  {
   "id": "scd",
   "name": "Canal dehiscence",
   "c": "purple",
   "icon": "sound",
   "subs": [
    [
     "Third window",
     [
      "no bone over the superior canal",
      "sound + pressure escape through it",
      "Minor, 1998"
     ]
    ],
    [
     "Symptoms",
     [
      "Tullio: vertigo with loud sound",
      "Hennebert: vertigo on straining",
      "autophony · hears eyes, pulse, steps"
     ]
    ],
    [
     "Audiogram",
     [
      "low-frequency air–bone gap",
      "supranormal bone conduction",
      "stapedial reflexes present"
     ]
    ],
    [
     "Confirm",
     [
      "cVEMP low threshold, oVEMP large",
      "ocular VEMP at 4 kHz most specific",
      "CT in canal plane (Pöschl)",
      "thin bone mimics: never CT alone"
     ]
    ],
    [
     "Treat",
     [
      "only if disabling",
      "plug or resurface",
      "transmastoid plugging favoured",
      "never stapes surgery"
     ]
    ]
   ]
  },
