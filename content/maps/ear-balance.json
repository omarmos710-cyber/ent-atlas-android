 "cards": [
  {
   "st": "timing",
   "art": "ap_dizzy",
   "c": "blue",
   "row": "top",
   "zone": 0,
   "t": "Timing and triggers",
   "tag": "interchange",
   "why": "Not the word the patient uses, but how long spells last and what brings them on.",
   "see": [
    "seconds, positional → BPPV",
    "20 min–12 h + fluctuating ear → Ménière's",
    "5 min–72 h ± headache → migraine",
    "days, continuous → neuritis or stroke",
    "most days > three months → PPPD"
   ],
   "warn": "Presyncope is not vertigo: lying and standing BP, ECG."
  },
  {
   "st": "dh",
   "art": "vest",
   "c": "orange",
   "row": "top",
   "zone": 1,
   "t": "Dix–Hallpike",
   "tag": "interchange",
   "why": "Head turned 45°, then lie back with it hanging about 20° below horizontal. Watch latency, duration, direction and fatigue.",
   "see": [
    "peripheral: latency 2–20 seconds",
    "under a minute",
    "fixed, towards the undermost ear",
    "fatigues · severe vertigo"
   ],
   "warn": "No latency, no fatigue, over a minute = central."
  },
  {
   "st": "stroke",
   "art": "vertigo",
   "c": "red",
   "row": "top",
   "zone": 1,
   "t": "Posterior circulation stroke",
   "tag": "red exit",
   "why": "The one not to miss. Early MRI misses up to 1 in 5 in the first 48 hours.",
   "see": [
    "AICA: + hearing loss, facial palsy",
    "PICA (Wallenberg): dysphagia, Horner"
   ],
   "do": [
    "CT + CT angiography first",
    "MRI with diffusion = gold standard",
    "within 4.5 h: thrombolysis, stroke team"
   ]
  },
  {
   "st": "vs",
   "art": "vs",
   "c": "brown",
   "row": "top",
   "zone": 2,
   "w": 1.5,
   "t": "Vestibular schwannoma",
   "tag": "exclude",
   "why": "Grows slowly and the brain compensates as slowly: unsteadiness rather than vertigo.",
   "see": [
    "one-sided SNHL, discrimination worst",
    "~80% of CPA tumours · ~1–2 mm a year",
    "V: reduced corneal reflex first (~2.5 cm)",
    "early facial palsy → another diagnosis"
   ],
   "do": [
    "MRI with gadolinium = gold standard",
    "small: most watched · rescan at six months",
    "radiosurgery: growth control 90–95%",
    "large, brainstem compression: surgery"
   ],
   "warn": "No lumbar puncture: herniation with a large tumour."
  },
  {
   "st": "bppv",
   "art": "vertigo",
   "c": "orange",
   "row": "top",
   "zone": 4,
   "w": 1.5,
   "t": "BPPV → Epley",
   "why": "Otoconia from the utricle settle in a canal and move with gravity when the head changes position (canalolithiasis).",
   "see": [
    "posterior canal 85–95%",
    "under a minute, on lying down",
    "no hearing loss",
    "torsional upbeat, after a latency"
   ],
   "do": [
    "Epley: ~80% one go, > 90% after four",
    "horizontal canal: Lempert barbecue roll",
    "no sedatives · no routine imaging",
    "recurs: up to a third in four years"
   ]
  },
  {
   "st": "men",
   "art": "meniere",
   "c": "green",
   "row": "top",
   "zone": 3,
   "w": 1.5,
   "t": "Ménière's disease",
   "tag": "interchange",
   "why": "Endolymphatic hydrops: small ruptures let potassium-rich endolymph mix with perilymph and poison the hair cells — an attack.",
   "see": [
    "≥ two spontaneous spells, 20 min–12 h",
    "documented low–mid-frequency SNHL",
    "fluctuating hearing, tinnitus, fullness",
    "normal drum · onset 35–60 years"
   ],
   "do": [
    "audiogram + MRI with contrast for all",
    "salt ~1.5–2 g a day",
    "betahistine trial: BEMED = placebo",
    "acute: sedatives, a few days only"
   ]
  },
  {
   "st": "its",
   "art": "meniere",
   "c": "green",
   "row": "top",
   "zone": 4,
   "t": "When medicines fail",
   "why": "The choice depends on whether the ear still hears usefully.",
   "do": [
    "IT methylprednisolone ≈ gentamicin",
    "gentamicin: vertigo control 80–90%",
    "… some hearing loss in 4–30%",
    "no useful hearing → labyrinthectomy"
   ],
   "warn": "Before destroying one ear, make sure the other is healthy."
  },
  {
   "st": "vm",
   "art": "ap_dizzy",
   "c": "grey",
   "row": "top",
   "zone": 3,
   "t": "Vestibular migraine",
   "tag": "look-alike",
   "why": "Commonest cause of spontaneous recurrent vertigo; missed because many attacks come without headache.",
   "see": [
    "≥ five episodes, 5 min–72 h",
    "migraine, current or previous",
    "migrainous feature in ≥ half"
   ],
   "do": [
    "no confirmatory test: clinical",
    "trial of prophylaxis if in doubt"
   ]
  },
  {
   "st": "child",
   "art": "dizzychild",
   "c": "pink",
   "row": "bottom",
   "zone": 0,
   "t": "The dizzy child",
   "why": "Cannot describe vertigo: clings, falls, goes pale.",
   "see": [
    "glue ear: clumsy, not spinning",
    "BPPV: after head injury or ear surgery"
   ],
   "do": [
    "audiometry + tympanometry for all",
    "one foot: 5 seconds at 4 years"
   ]
  },
  {
   "st": "hints",
   "art": "ap_dizzy",
   "c": "blue",
   "row": "bottom",
   "zone": 1,
   "t": "HINTS",
   "tag": "interchange",
   "why": "Hours or days of continuous vertigo: neuritis, or a posterior circulation stroke in roughly one in ten.",
   "see": [
    "peripheral only if all three agree",
    "abnormal impulse · fixed nystagmus · no skew",
    "normal impulse, changing beat or skew = stroke",
    "plus: new hearing loss → AICA"
   ],
   "warn": "Beats early MRI in the first 48 hours, in trained hands."
  },
  {
   "st": "vhit",
   "art": "vest",
   "c": "teal",
   "row": "top",
   "zone": 2,
   "w": 1.4,
   "t": "vHIT · calorics",
   "why": "Calorics: each lateral canal, low frequency. vHIT: all six canals, high frequency.",
   "see": [
    "gain = eye ÷ head, normal ~0.8 or more",
    "covert saccades: only video sees them"
   ],
   "do": [
    "head up 30° · 30 and 44 °C",
    "COWS: cold opposite, warm same",
    "canal paresis > ~20–25%"
   ]
  },
  {
   "st": "neur",
   "art": "vertigo",
   "c": "blue",
   "row": "bottom",
   "zone": 3,
   "t": "Vestibular neuritis",
   "why": "Probably viral inflammation of the vestibular nerve.",
   "see": [
    "settles over two to three weeks",
    "hearing lost = labyrinthitis",
    "BPPV follows in up to 15%"
   ],
   "do": [
    "sedatives a few days · early rehabilitation",
    "steroids: faster calorics, no clear late gain"
   ],
   "warn": "No better at 2 to 3 weeks: MRI for a central lesion."
  },
  {
   "st": "bpvc",
   "art": "dizzychild",
   "c": "pink",
   "row": "bottom",
   "zone": 3,
   "t": "BPVC",
   "why": "A migraine precursor: sudden spells, with the child entirely normal between them.",
   "see": [
    "commonest at 2–6 years",
    "seconds to minutes · no hearing symptoms",
    "about half → migraine in adolescence"
   ],
   "warn": "Red flags (ataxia between attacks, morning headache): MRI."
  },
  {
   "st": "scd",
   "art": "scd",
   "c": "purple",
   "row": "bottom",
   "zone": 2,
   "w": 1.5,
   "t": "Superior canal dehiscence",
   "why": "A third window: sound and pressure energy escape through the missing bone over the superior canal.",
   "see": [
    "Tullio: vertigo with loud sound",
    "Hennebert: vertigo on straining",
    "autophony · hears eyes, pulse, steps",
    "low-tone gap, bone better than normal"
   ],
   "do": [
    "reflexes present · VEMP threshold low",
    "CT in the canal plane (Pöschl)",
    "thin bone mimics: never CT alone",
    "plug or resurface, only if disabling"
   ],
   "warn": "A conductive gap with present reflexes: no stapes surgery."
  }
 ],
