      "no hearing symptoms",
      "about half → migraine later"
     ]
    ],
    [
     "Other causes",
     [
      "older child: vestibular migraine",
      "glue ear: clumsy, not spinning",
      "enlarged aqueduct: stepwise loss",
      "BPPV only after trauma or surgery"
     ]
    ],
    [
     "Assess",
     [
      "audiometry + tympanometry for all",
      "one foot: 5 s at 4 years",
      "head impulse on a cartoon"
     ]
    ],
    [
     "Red flags → MRI",
     [
      "ataxia between attacks",
      "morning headache, vomiting",
      "changing or vertical nystagmus",
      "lost milestones"
     ]
    ]
