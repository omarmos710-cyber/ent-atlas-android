  {
   "id": "vest",
   "name": "Vestibular tests",
   "c": "teal",
   "icon": "target",
   "subs": [
    [
     "Nystagmus",
     [
      "beats away from a dead ear",
      "peripheral: fixation suppresses",
      "Alexander: stronger to fast phase",
      "downbeat → craniocervical junction"
     ]
    ],
    [
     "Calorics",
     [
      "head up 30° · 30 and 44 °C",
      "COWS: cold opposite, warm same",
      "canal paresis > ~20–25%",
      "perforation: air, never water"
     ]
    ],
    [
     "vHIT",
     [
      "gain = eye ÷ head, normal ≥ 0.8",
      "covert saccades: only video sees",
      "Ménière's: bad calorics, normal vHIT"
     ]
    ],
    [
     "VEMP",
     [
      "cervical: saccule, inferior nerve",
      "ocular: utricle, superior nerve",
      "works even in deaf ears"
     ]
    ],
    [
     "Fistula test",
     [
      "dead ear → false negative",
      "Hennebert sign: positive, no fistula"
     ]
    ]
   ]
