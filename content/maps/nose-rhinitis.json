 "cards": [
  {
   "st": "blocked",
   "art": "ap_block",
   "c": "blue",
   "row": "top",
   "zone": 0,
   "t": "Blocked nose",
   "why": "The nose gives about two-thirds of airway resistance, most of it at the internal valve, the narrowest point.",
   "see": [
    "nasal cycle in ~80%, every two to six hours",
    "airflow felt by trigeminal cold receptors"
   ]
  },
  {
   "st": "side",
   "art": "ap_rhin",
   "c": "orange",
   "row": "top",
   "zone": 1,
   "t": "Which side?",
   "tag": "interchange",
   "why": "Bilateral rhinorrhoea is almost always mucosal disease; one-sided discharge is a leak or a lesion until proven otherwise.",
   "see": [
    "bilateral, itchy, sneezing → allergic",
    "bilateral, watery, no itch → non-allergic",
    "unilateral, foul → foreign body, dental",
    "unilateral, bloody → tumour"
   ]
  },
  {
   "st": "dtest",
   "art": "ap_block",
   "c": "blue",
   "row": "top",
   "zone": 1,
   "t": "Fixed or fluctuating?",
   "tag": "interchange",
   "why": "Mucosal swelling shrinks with decongestant; a deviation, a spur or a polyp does not change.",
   "see": [
    "fluctuating, bilateral → rhinitis, CRS",
    "fixed, unilateral → septum, valve, mass",
    "Cottle's test: cheek drawn laterally"
   ],
   "warn": "One-sided with blood or pain: tumour. Adolescent boy who bleeds: no biopsy."
  },
  {
   "st": "csf",
   "art": "ap_rhin",
   "c": "orange",
   "row": "top",
   "zone": 2,
   "t": "CSF leak",
   "why": "Subarachnoid space open to the nose: clear, watery, one-sided, worse bending forward (teapot sign).",
   "see": [
    "80–90% traumatic",
    "spontaneous: obese women, raised pressure",
    "beta-2 transferrin or beta-trace protein"
   ],
   "do": [
    "traumatic: conservative, many close in a week",
    "persistent: endoscopic repair",
    "spontaneous: treat the raised pressure too"
   ],
   "warn": "Halo and glucose tests are unreliable."
  },
  {
   "st": "nonall",
   "art": "ap_rhin",
   "c": "orange",
   "row": "top",
   "zone": 2,
   "t": "Non-allergic rhinitis",
   "why": "Similar symptoms without atopy, triggered by cold air, smells, food or alcohol.",
   "see": [
    "NARES may precede polyps, asthma, aspirin"
   ],
   "do": [
    "watery: ipratropium = drug of choice",
    "steroid spray: NARES, congestion",
    "intractable: posterior nasal nerve > vidian"
   ],
   "warn": "Vidian neurectomy risks a dry eye."
  },
  {
   "st": "spray",
   "art": "rhinitis",
   "c": "red",
   "row": "top",
   "zone": 3,
   "t": "Steroid spray",
   "why": "The most effective single treatment for persistent or moderate to severe disease; full effect in about two weeks.",
   "see": [
    "ARIA intermittent: < 4 days a week or < 4 weeks"
   ],
   "do": [
    "2 to 3 month trial before judging",
    "aim away from the septum",
    "uncontrolled: immunotherapy, about three years",
    "no depot steroid injections"
   ],
   "warn": "Decongestant drops beyond five to seven days: rhinitis medicamentosa."
  },
  {
   "st": "turb",
   "art": "atrophic",
   "c": "blue",
   "row": "top",
   "zone": 4,
   "t": "Turbinates",
   "why": "Simple rhinitis is reversible: the turbinate pits and shrinks. Hypertrophic rhinitis is fibrosed: no pitting, little shrinkage.",
   "see": [
    "hypertrophic: mulberry inferior turbinate"
   ],
   "do": [
    "simple: medical",
    "hypertrophic: turbinate reduction"
   ],
   "warn": "Excessive removal leaves crusting and an empty nose."
  },
  {
   "st": "pnd",
   "art": "ap_pnd",
   "c": "green",
   "row": "bottom",
   "zone": 0,
   "t": "Postnasal drip",
   "why": "600–700 mL of mucus a day is swallowed unnoticed. Drip is felt when volume, thickness, clearance or sensation change.",
   "see": [
    "chronic cough: eight weeks or more"
   ]
  },
  {
   "st": "psrc",
   "art": "ap_pnd",
   "c": "green",
   "row": "bottom",
   "zone": 1,
   "t": "Which source?",
   "tag": "interchange",
   "why": "Nose, sinuses, nasopharynx, reflux, drying drugs, or a hypersensitive throat.",
   "do": [
    "reflux: lifestyle, alginate, PPI trial",
    "normal scope: speech therapy",
    "refractory cough: gabapentin, amitriptyline"
   ],
   "warn": "Cough on an ACE inhibitor: the drug. No repeated antibiotics for catarrh."
  },
  {
   "st": "rhin",
   "art": "rhinitis",
   "c": "red",
   "row": "bottom",
   "zone": 2,
   "t": "Allergic rhinitis",
   "tag": "interchange",
   "why": "Allergen bridges two IgE molecules on a mast cell, which releases histamine: early phase in 5 to 30 minutes, late phase 2 to 8 hours later.",
   "see": [
    "pale, bluish mucosa · allergic salute",
    "skin prick: wheal ≥ 3 mm over control",
    "only ~half of positives have disease",
    "20 to 30% of rhinitis patients have asthma"
   ]
  },
  {
   "st": "atro",
   "art": "atrophic",
   "c": "purple",
   "row": "bottom",
   "zone": 2,
   "t": "Atrophic rhinitis",
   "why": "Ciliated epithelium turns squamous, glands and vessels atrophy and turbinate bone is resorbed: a wide, crusted nose.",
   "see": [
    "young woman, from puberty",
    "foul crusts · merciful anosmia",
    "paradoxical obstruction: wide nose",
    "Klebsiella ozaenae: secondary invader"
   ]
  },
  {
   "st": "douche",
   "art": "atrophic",
   "c": "purple",
   "row": "bottom",
   "zone": 3,
   "t": "Nasal hygiene",
   "why": "Lifelong care; the evidence for every treatment comes from case series.",
   "do": [
    "alkaline douche, crust removal",
    "25% glucose in glycerine",
    "antibiotics 7 to 10 days, not long-term",
    "Young's: close nostrils, reopen after six months"
   ]
  },
  {
   "st": "septum",
   "art": "ap_block",
   "c": "blue",
   "row": "bottom",
   "zone": 4,
   "t": "Septum and valve",
   "why": "Deviations at or in front of the internal valve (Cottle areas 1 to 3) obstruct most.",
   "do": [
    "septoplasty: L-strut ≥ 1 cm",
    "high or caudal: functional septorhinoplasty",
    "treat the mucosa first"
   ],
   "warn": "Over-reduced turbinates: empty nose syndrome."
  }
 ],
