 "cards": [
  {
   "st": "hoarse",
   "art": "ap_hoarse",
   "c": "red",
   "row": "top",
   "zone": 0,
   "t": "Hoarse over three weeks",
   "why": "The commonest presenting symptom of laryngeal cancer: any adult hoarse over three weeks has the folds seen.",
   "see": [
    "after a shout → haemorrhage, polyp",
    "after a cold → laryngitis",
    "after surgery, tube → nerve, arytenoid",
    "gradual → lesion or cancer"
   ],
   "do": [
    "smoker, drinker or over 45: urgent",
    "stridor, breathless: airway first",
    "American guideline: four weeks",
    "no antibiotics, steroids, antireflux first"
   ],
   "warn": "Breathy voice + weak cough: image the nerve course."
  },
  {
   "st": "scope",
   "art": "ap_hoarse",
   "c": "red",
   "row": "bottom",
   "zone": 0,
   "t": "Scope + strobe",
   "see": [
    "breathy = a gap",
    "rough = irregular vibration",
    "strained = tension or dystonia"
   ],
   "do": [
    "nasendoscope: sniff, 'ee', cough",
    "stroboscopy: the mucosal wave"
   ]
  },
  {
   "st": "chl",
   "art": "laryngitis",
   "c": "red",
   "row": "bottom",
   "zone": 1,
   "t": "Chronic laryngitis",
   "tag": "interchange",
   "why": "A description, not a diagnosis: name the cause. Smoking is the main one; others are reflux and voice misuse.",
   "see": [
    "voice tires and fails by evening",
    "hawking, throat clearing, dry cough"
   ],
   "do": [
    "stop smoking, alcohol; voice therapy",
    "treat infection, treat reflux",
    "biopsy: persistent, asymmetric, smoker"
   ],
   "warn": "TB, granulomas and carcinoma can look alike."
  },
  {
   "st": "lpr",
   "art": "laryngitis",
   "c": "red",
   "row": "top",
   "zone": 1,
   "t": "Reflux (LPR)",
   "why": "Small amounts of acid and pepsin that the oesophagus tolerates injure the larynx, so few have heartburn.",
   "see": [
    "heartburn in only a quarter to a third",
    "posterior oedema · pseudosulcus"
   ],
   "do": [
    "mild: alginate liquid, 8 to 12 weeks",
    "symptoms or signs: PPI twice daily, 8 to 12 weeks",
    "pH–impedance: the most accurate test"
   ],
   "warn": "PPI evidence is modest: stop if no response."
  },
  {
   "st": "tb",
   "art": "laryngitis",
   "c": "grey",
   "row": "top",
   "zone": 1,
   "t": "TB larynx",
   "tag": "mimic",
   "why": "Almost always secondary to active lung TB, through infected sputum.",
   "see": [
    "posterior larynx · weak voice first",
    "mouse-nibbled fold · turban epiglottis"
   ],
   "do": [
    "chest radiograph, sputum, biopsy"
   ],
   "warn": "Lupus: anterior, painless, no lung disease."
  },
  {
   "st": "gran",
   "art": "benign",
   "c": "red",
   "row": "top",
   "zone": 2,
   "t": "Contact granuloma",
   "why": "The vocal processes hammer together with hard glottal attacks and throat clearing; reflux is a major factor.",
   "see": [
    "pain on speaking, to the ear",
    "constant throat clearing"
   ],
   "do": [
    "PPI twice daily, 3 months",
    "voice therapy: stop throat clearing",
    "surgery last: recurrence common"
   ]
  },
  {
   "st": "nod",
   "art": "benign",
   "c": "green",
   "row": "top",
   "zone": 2,
   "t": "Vocal nodules",
   "why": "Chronic voice misuse, at the midpoint of the membranous fold, where vibration and collision are greatest.",
   "see": [
    "bilateral, symmetrical",
    "teachers, singers, children",
    "strobe: hourglass, wave preserved"
   ],
   "do": [
    "voice therapy: the cornerstone",
    "excise only if persists after therapy"
   ]
  },
  {
   "st": "polyp",
   "art": "benign",
   "c": "green",
   "row": "top",
   "zone": 2,
   "t": "Polyp · cyst",
   "why": "A sudden shout bleeds into one fold: a polyp. A cyst stiffens a segment instead.",
   "see": [
    "polyp: unilateral · diplophonia",
    "men of thirty to fifty",
    "cyst: stiff segment, reduced wave"
   ],
   "do": [
    "polyp: excision + voice therapy",
    "cyst: no response to therapy → excise"
   ]
  },
  {
   "st": "reinke",
   "art": "benign",
   "c": "brown",
   "row": "bottom",
   "zone": 2,
   "t": "Reinke's oedema",
   "why": "Gelatinous fluid fills Reinke's space; smoking is almost always responsible.",
   "see": [
    "pale, translucent, both folds",
    "deep rough voice, noticed in women"
   ],
   "do": [
    "stop smoking; reflux, thyroid",
    "decortication, one side at a time"
   ]
  },
  {
   "st": "leuko",
   "art": "benign",
   "c": "brown",
   "row": "bottom",
   "zone": 2,
   "t": "Leukoplakia",
   "why": "Histology runs from keratosis through dysplasia to carcinoma in situ and invasive carcinoma: a precancerous condition.",
   "see": [
    "white plaque, smoker, mobile fold"
   ],
   "do": [
    "biopsy or excisional microflap",
    "stop smoking · follow up"
   ],
   "warn": "Reduced wave or impaired mobility: suspect carcinoma."
  },
  {
   "st": "rrp",
   "art": "benign",
   "c": "green",
   "row": "bottom",
   "zone": 2,
   "t": "Papillomatosis",
   "why": "HPV 6 and 11: about 80% of benign laryngeal neoplasms.",
   "see": [
    "child: hoarse, then stridor",
    "misread as asthma or croup"
   ],
   "do": [
    "debulk, not cure: microdebrider, laser",
    "cidofovir, bevacizumab if frequent",
    "avoid tracheostomy: tracheal spread"
   ]
  },
  {
   "st": "sln",
   "art": "vfp",
   "c": "purple",
   "row": "top",
   "zone": 3,
   "t": "Superior nerve",
   "see": [
    "cannot raise pitch",
    "askew glottis, lax wavy fold"
   ]
  },
  {
   "st": "uni",
   "art": "vfp",
   "c": "purple",
   "row": "bottom",
   "zone": 3,
   "t": "One fold palsy",
   "why": "The folds cannot close; the aim is to close the glottic gap.",
   "see": [
    "weak, breathy; a third no symptoms"
   ],
   "do": [
    "voice therapy early",
    "early temporary injection",
    "permanent after about 9 to 12 months",
    "type I thyroplasty ± arytenoid adduction"
   ]
  },
  {
   "st": "lrn",
   "art": "lxanat",
   "c": "purple",
   "row": "bottom",
   "zone": 3,
   "t": "Two nerves",
   "why": "The left recurrent nerve hooks under the aortic arch: a long course, so paralysed far more often.",
   "see": [
    "recurrent: all intrinsic but cricothyroid",
    "external branch → cricothyroid",
    "posterior cricoarytenoid: only abductor"
   ]
  },
  {
   "st": "bil",
   "art": "vfp",
   "c": "purple",
   "row": "top",
   "zone": 3,
   "t": "Both folds",
   "why": "Both lie near the midline: good voice, poor airway.",
   "do": [
    "tracheostomy: the gold standard",
    "posterior cordotomy (Kashima)",
    "after thyroidectomy: wait, many recover"
   ]
  },
  {
   "st": "immob",
   "art": "vfp",
   "c": "purple",
   "row": "top",
   "zone": 3,
   "t": "Fold won't move",
   "tag": "interchange",
   "w": 1.5,
   "why": "A paralysed fold is a sign, not a diagnosis: find the cause along the whole nerve.",
   "see": [
    "malignancy and surgery lead",
    "thyroidectomy: commonest bilateral",
    "idiopathic about 20 to 30%"
   ],
   "do": [
    "contrast CT skull base → aortic arch",
    "palpate arytenoid: fixed or paralysed?",
    "FEES or videofluoroscopy: aspiration"
   ],
   "warn": "Left palsy: exclude bronchogenic carcinoma."
  },
  {
   "st": "aph",
   "art": "voice",
   "c": "teal",
   "row": "top",
   "zone": 4,
   "t": "Functional aphonia",
   "why": "The folds stay apart when speaking but close normally on coughing.",
   "see": [
    "sudden whisper, stressed young women"
   ],
   "do": [
    "voice back through cough, hum"
   ],
   "warn": "Puberphonia: Gutzmann pressure gives a low voice."
  },
  {
   "st": "mtd",
   "art": "voice",
   "c": "teal",
   "row": "top",
   "zone": 4,
   "t": "Muscle tension",
   "why": "Excessive tension of the laryngeal and neck muscles during phonation: a functional disorder.",
   "see": [
    "strained, tiring, neck ache",
    "supraglottic squeeze on scope"
   ],
   "do": [
    "voice therapy + manual therapy"
   ]
  },
  {
   "st": "dyst",
   "art": "voice",
   "c": "teal",
   "row": "bottom",
   "zone": 4,
   "t": "Laryngeal dystonia",
   "why": "Spasms during speech in a structurally normal larynx.",
   "see": [
    "adductor about 90%: strangled breaks",
    "count 80 to 90 (adductor), 60 to 70 (abductor)"
   ],
   "do": [
    "botulinum toxin A: lasts three to four months"
   ]
  }
 ],
