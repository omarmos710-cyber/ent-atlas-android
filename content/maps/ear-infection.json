 "cards": [
  {
   "st": "tube",
   "art": "om",
   "c": "blue",
   "row": "top",
   "zone": 0,
   "t": "A cold → tube blocks",
   "why": "A child's tube is shorter, wider and more horizontal. Secretions from the nasopharynx reach the middle ear easily, and the middle ear drains poorly.",
   "see": [
    "a cold, then fullness and muffled hearing"
   ]
  },
  {
   "st": "aom",
   "art": "om",
   "c": "blue",
   "row": "top",
   "zone": 1,
   "w": 1.7,
   "t": "Acute otitis media",
   "tag": "interchange",
   "why": "Bacteria multiply in the closed cleft and pus pushes the drum out. Four lines leave this station.",
   "see": [
    "onset < 48 h, after a cold",
    "bulging + poor mobility = diagnosis",
    "S. pneumoniae > H. influenzae > M. catarrhalis"
   ],
   "do": [
    "analgesia for every child",
    "NICE: immediate if very unwell or high risk",
    "consider immediate/back-up: < 2 y both ears; otorrhoea",
    "amoxicillin 5–7 days",
    "safety-net at 48–72 h"
   ],
   "warn": "Most journeys end at Heals. Complications follow 0.05–0.25% of AOM."
  },
  {
   "st": "ome",
   "art": "om",
   "c": "blue",
   "row": "top",
   "zone": 1,
   "t": "Glue ear",
   "why": "The infection settles but the tube stays poor, so the fluid stays.",
   "see": [
    "fluid behind an intact drum",
    "flat type B tympanogram",
    "20–40 dB conductive",
    "chronic after 3 months"
   ]
  },
  {
   "st": "mast",
   "art": "mastoiditis",
   "c": "brown",
   "row": "top",
   "zone": 2,
   "t": "Mastoiditis",
   "why": "The antrum is continuous with the middle ear. When pus cannot drain, the route it takes decides the complication.",
   "see": [
    "half are ≤ 4 years",
    "post-auricular pain, fever",
    "pinna forwards + down",
    "sagging posterosuperior wall · reservoir sign"
   ],
   "do": [
    "admit · IV ceftriaxone 50–75 mg/kg (max 2 g)",
    "myringotomy + grommet · ~2 weeks total",
    "mastoidectomy: abscess, coalescence, no better at 48 h"
   ],
   "warn": "Masked after antibiotics: quiet destruction."
  },
  {
   "st": "sub",
   "art": "mastoiditis",
   "c": "green",
   "row": "top",
   "zone": 3,
   "t": "Abscess",
   "tag": "outwards",
   "why": "Outwards through the cortex, or down through the tip into the neck.",
   "see": [
    "subperiosteal (commonest)",
    "Bezold: under SCM",
    "Luc · zygomatic · Citelli"
   ]
  },
  {
   "st": "apex",
   "art": "petrous",
   "c": "green",
   "row": "top",
   "zone": 3,
   "t": "Petrous apex",
   "tag": "inwards",
   "why": "Only an aerated apex can carry infection this far medially — beside V and VI.",
   "see": [
    "only ~30% of apices are aerated",
    "Gradenigo: discharge, retro-orbital pain (V), diplopia (VI)",
    "full triad uncommon today"
   ],
   "do": [
    "MRI + DWI = gold standard",
    "HRCT: septa broken, erosion",
    "MRV or CTA for sinus, carotid"
   ]
  },
  {
   "st": "dura",
   "art": "icc",
   "c": "red",
   "row": "top",
   "zone": 4,
   "t": "Through the dura",
   "tag": "interchange",
   "why": "Cholesteatoma, osteitis and granulation destroy the tegmen or the sinus plate, bringing infection to the dura. Six complications lie beyond.",
   "do": [
    "CT, then MRI + MRV",
    "LP only once mass effect excluded",
    "patient first, ear last",
    "look for a second complication"
   ]
  },
  {
   "st": "perf",
   "art": "om",
   "c": "teal",
   "row": "bottom",
   "zone": 1,
   "w": 1,
   "t": "Perforation",
   "why": "Pus under pressure bursts the drum; discharge appears and the pain settles.",
   "see": [
    "~5% of AOM",
    "~90% heal"
   ]
  },
  {
   "st": "csom",
   "art": "csom",
   "c": "teal",
   "row": "bottom",
   "zone": 1,
   "t": "Safe CSOM",
   "why": "Skin meets mucosa round the edge, so the hole won't close; biofilms bring relapse.",
   "see": [
    "profuse mucoid, not foul · central hole",
    "conductive, rarely > 50 dB"
   ],
   "do": [
    "aural toilet · quinolone drops 1–2 weeks",
    "acetic acid 1.5% for Pseudomonas",
    "tympanoplasty once dry: 60–90%"
   ],
   "warn": "Never avulse a polyp: stapes, VII, lateral canal."
  },
  {
   "st": "tbo",
   "art": "tbom",
   "c": "grey",
   "row": "bottom",
   "zone": 1,
   "w": 1,
   "t": "TB otitis",
   "tag": "mimic",
   "why": "A chronic ear that will not get better; the treatment is medical.",
   "see": [
    "painless, thin, persistent discharge",
    "multiple perforations · pale granulation",
    "facial palsy ~10%"
   ],
   "do": [
    "biopsy: histology + culture",
    "HRZE 2 months → HR 4 months"
   ],
   "warn": "Negative smear does not exclude. Syphilis: treat as neurosyphilis."
  },
  {
   "st": "chole",
   "art": "chole",
   "c": "purple",
   "row": "bottom",
   "zone": 1,
   "w": 1.35,
   "t": "Cholesteatoma",
   "tag": "interchange",
   "why": "Keratinising squamous epithelium in the cleft. It grows, gets infected and erodes bone.",
   "see": [
    "scanty, foul discharge",
    "attic / posterosuperior marginal hole",
    "white flakes, eroded scutum"
   ],
   "do": [
    "fistula test in every case · HRCT",
    "non-EPI DWI: sens 91%, spec 92%",
    "surgery: safe → dry → hearing",
    "follow ≥ five years"
   ],
   "warn": "Discharge that suddenly stops = pus tracking in."
  },
  {
   "st": "fist",
   "art": "fistula",
   "c": "green",
   "row": "bottom",
   "zone": 3,
   "t": "Labyrinth",
   "why": "Cholesteatoma erodes the bony labyrinth (a fistula); toxins or bacteria reaching it cause labyrinthitis.",
   "see": [
    "fistula: 7–10% of cholesteatomas · 90% lateral canal",
    "HRCT shows only ~60%",
    "fistula test positive in only 30–50%",
    "serous: nystagmus towards the ear, recovers",
    "suppurative: towards healthy ear, dead ear"
   ],
   "do": [
    "fistula test · audiogram · HRCT",
    "IV antibiotics · surgery for the cholesteatoma"
   ]
  },
  {
   "st": "men",
   "art": "icc",
   "c": "red",
   "row": "bottom",
   "zone": 4,
   "t": "Meningitis",
   "see": [
    "the commonest · neck stiffness"
   ]
  },
  {
   "st": "ab",
   "art": "icc",
   "c": "red",
   "row": "bottom",
   "zone": 4,
   "t": "Brain abscess",
   "see": [
    "the next commonest",
    "temporal: aphasia, field defect",
    "cerebellar: ataxia, nystagmus",
    "IV ~6 weeks after drainage"
   ]
  },
  {
