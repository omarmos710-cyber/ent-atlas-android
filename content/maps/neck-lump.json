 "cards": [
  {
   "st": "child",
   "art": "paeds_neck",
   "c": "orange",
   "row": "top",
   "zone": 0,
   "t": "The child's neck lump",
   "why": "Most are reactive nodes; the congenital masses that remain follow the embryology, and recur if the tract is left.",
   "see": [
    "reactive nodes: the commonest",
    "transilluminant, posterior triangle: lymphatic malformation"
   ],
   "do": [
    "ultrasound first in every child",
    "macrocystic lymphatic: sclerotherapy",
    "extensive microcystic: sirolimus"
   ],
   "warn": "Biopsy: hard, fixed or matted node over 2–3 cm, supraclavicular node, B symptoms."
  },
  {
   "st": "vasc",
   "art": "vascneck",
   "c": "red",
   "row": "top",
   "zone": 1,
   "t": "Haemangioma or malformation?",
   "why": "A haemangioma grows after birth, then involutes. A malformation is present at birth and grows with the child.",
   "see": [
    "GLUT-1: haemangioma positive, malformation negative",
    "beard distribution → subglottic haemangioma"
   ],
   "do": [
    "propranolol 1 → 3 mg/kg/day",
    "AVM: embolise, then excise the nidus"
   ],
   "warn": "Never ligate an AVM's feeding vessels proximally."
  },
  {
   "st": "hiv",
   "art": "hivent",
   "c": "purple",
   "row": "top",
   "zone": 2,
   "t": "HIV clues in the neck",
   "why": "An ENT finding is often the first clue to HIV.",
   "see": [
    "hairy leukoplakia: lateral tongue, EBV",
    "persistent thrush · necrotising gingivitis",
    "bilateral parotid cysts · generalised nodes"
   ],
   "do": [
    "fourth-generation antigen + antibody test",
    "matted or asymmetric nodes: FNA or excision",
    "ART at diagnosis, whatever the CD4"
   ],
   "warn": "Parotid cysts regress on ART; parotidectomy only if disfiguring or suspicious."
  },
  {
   "st": "tgdc",
   "art": "paeds_neck",
   "c": "orange",
   "row": "top",
   "zone": 3,
   "w": 1.25,
   "t": "Thyroglossal cyst → Sistrunk",
   "why": "Tethered to the foramen caecum, so it rises on swallowing and on tongue protrusion.",
   "see": [
    "commonest congenital neck mass",
    "midline; subhyoid = commonest site",
    "~1% carcinoma, almost always papillary"
   ],
   "do": [
    "ultrasound: confirm a normal thyroid",
    "Sistrunk: cyst + tract + body of hyoid",
    "recurs: cystectomy up to half, Sistrunk < 5% (most series)"
   ],
   "warn": "It may be the only functioning thyroid tissue."
  },
  {
   "st": "branch",
   "art": "paeds_neck",
   "c": "orange",
   "row": "top",
   "zone": 3,
   "t": "Second cleft anomaly",
   "why": "A cleft or cervical sinus that fails to obliterate leaves a cyst, sinus or fistula.",
   "see": [
    "~90% of branchial anomalies",
    "cyst: front of sternomastoid, upper–middle third",
    "pit: lower third, anterior border",
    "tract between carotids → tonsillar fossa"
   ],
   "do": [
    "excise once infection settles · step-ladder"
   ],
   "warn": "New lateral cyst over 40: cystic metastasis until proved otherwise."
  },
  {
   "st": "tb",
   "art": "neckmass",
   "c": "purple",
   "row": "top",
   "zone": 4,
   "t": "Tuberculous node",
   "tag": "scrofula",
   "why": "Discrete, then matted nodes, cold abscess, collar-stud abscess, then a sinus.",
   "do": [
    "FNA: caseating granulomas, acid-fast bacilli",
    "HRZE 2 months → HR 4 months",
    "aspirate abscesses, never incise"
   ],
   "warn": "Nodes may enlarge on treatment: paradoxical reaction."
  },
  {
   "st": "cup",
   "art": "neckmass",
   "c": "blue",
   "row": "top",
   "zone": 4,
   "t": "Unknown primary",
   "why": "A squamous node with no primary on examination, endoscopy and imaging: search in a set order.",
   "do": [
    "PET-CT before panendoscopy",
    "panendoscopy with biopsies",
    "tonsillectomy + tongue-base mucosectomy",
    "p16 → oropharynx · EBV → nasopharynx",
    "neck dissection + radiotherapy, or chemoradiotherapy"
   ]
  },
  {
   "st": "adult",
   "art": "neckmass",
   "c": "blue",
   "row": "bottom",
   "zone": 0,
   "t": "The adult neck lump",
   "why": "Over forty and a smoker: a persistent lateral lump is metastatic squamous carcinoma until proved otherwise.",
   "see": [
    "rule of 80: neoplastic, malignant, metastatic",
    "days inflammatory · months neoplastic",
    "years: congenital or benign"
   ]
  },
  {
   "st": "exam",
   "art": "neckmass",
   "c": "blue",
   "row": "bottom",
   "zone": 1,
   "t": "Head and neck exam",
   "why": "Read the node back to its primary.",
   "see": [
    "level II: tonsil, tongue base, nasopharynx",
    "posterior triangle → nasopharynx",
    "level VI → thyroid · Virchow → abdomen, chest"
   ],
   "do": [
    "palpate from behind · flexible nasendoscopy"
   ]
  },
  {
   "st": "usfna",
   "art": "neckmass",
   "c": "blue",
   "row": "bottom",
   "zone": 2,
   "t": "Ultrasound + FNA",
   "tag": "interchange",
   "why": "Ultrasound shows cystic or solid, architecture and vascularity; FNA gives cytology before anyone cuts.",
   "see": [
    "p16/HPV, EBV, thyroglobulin, flow cytometry",
    "cystic level II, adult: HPV or papillary metastasis"
   ],
   "do": [
    "non-diagnostic: repeat, or core biopsy",
    "lymphoma: core or excision, fresh tissue",
    "CT or MRI for extent"
   ],
   "warn": "Never excise an adult node first: it breaches the fascial planes and contaminates the field."
  },
  {
   "st": "opg",
   "art": "jaw",
   "c": "teal",
   "row": "bottom",
   "zone": 1,
   "t": "OPG, then aspirate",
   "why": "The radiograph does most of the work.",
   "see": [
    "apex of a non-vital tooth = radicular",
    "crown of an unerupted tooth = dentigerous",
    "multiple keratocysts = Gorlin"
   ],
   "do": [
    "aspirate before any biopsy",
    "blood: vascular lesion, never biopsy blind"
   ],
   "warn": "Numb lower lip: malignancy or osteomyelitis."
  },
  {
   "st": "cbt",
   "art": "vascneck",
   "c": "red",
   "row": "bottom",
   "zone": 3,
   "t": "Carotid body tumour",
   "why": "No needle, no biopsy: they bleed, rarely give a diagnosis, and imaging is characteristic.",
   "see": [
    "bifurcation, level of the hyoid",
    "side to side, not vertically (Fontaine)",
    "pulsation · bruit · ~1 mm a year",
    "splays internal + external carotids: lyre sign",
    "salt-and-pepper on MRI",
    "schwannoma: no flow voids, target sign on T2"
   ]
  },
  {
   "st": "amelo",
   "art": "jaw",
   "c": "teal",
   "row": "bottom",
   "zone": 3,
   "t": "Ameloblastoma",
   "why": "Benign but locally aggressive odontogenic tumour.",
   "see": [
    "~80% mandible, molar–ramus",
    "multilocular soap bubble",
    "knife-edge root resorption"
   ],
   "do": [
    "resect 1–1.5 cm beyond the radiological edge",
    "lifelong follow-up"
   ],
   "warn": "Enucleation and curettage: recurrence 50–90%."
  },
  {
   "st": "surg",
   "art": "vascneck",
   "c": "red",
   "row": "bottom",
   "zone": 4,
   "t": "Before and at surgery",
   "see": [
    "up to 40% hereditary: SDH genetics",
    "metanephrines before anaesthesia",
    "malignant only if it metastasises"
   ],
   "do": [
    "Shamblin III encases the carotids",
    "bilateral: stage, or observe one"
   ],
   "warn": "First bite syndrome: lost sympathetic supply to the parotid."
  }
 ],
