    [
     "Three questions",
     [
      "conductive or sensorineural?",
      "one ear or both?",
      "sudden, progressive or fluctuating?"
     ]
    ],
    [
     "Conductive",
     [
      "low tones worse, good discrimination",
      "alone never exceeds ~60 dB",
      "present reflexes → CT for dehiscence"
     ]
    ],
    [
     "Sensorineural",
     [
      "high tones worse, poor in noise",
      "asymmetric → MRI",
      "sudden → steroids same day + MRI"
     ]
    ],
    [
     "WHO 2021",
     [
      "better-ear average incl. 4000 Hz",
      "normal < 20 · mild 20 · moderate 35",
      "severe 65 · profound 80 · complete 95"
     ]
    ],
    [
     "Non-organic",
     [
      "SRT > 10 dB better than PTA",
      "no shadow curve · positive Stenger",
      "reflexes present despite 'deafness'"
     ]
    ]
   ]
  },
  {
   "id": "audio",
   "name": "Hearing tests",
   "c": "orange",
   "icon": "sound",
   "subs": [
    [
     "Tuning forks",
     [
      "512 Hz fork",
      "Rinne negative = conductive ≥ ~20 dB",
      "Weber → poorer ear if conductive",
      "false-negative Rinne: mask good ear"
     ]
    ],
    [
     "Audiogram",
     [
      "bone conduction = cochlear function",
      "air–bone gap = conductive part",
      "≥ 15 dB at two adjacent frequencies → MRI"
     ]
    ],
    [
     "Masking",
     [
      "ears differ ≥ 40 dB on air",
      "any air–bone gap for bone",
      "plateau (Hood) technique",
      "unmasked dead ear → shadow curve"
     ]
    ],
    [
     "Tympanogram",
     [
      "B + normal volume = fluid",
      "B + high volume = perforation, grommet",
      "As otosclerosis · Ad discontinuity",
      "C = negative pressure, tube"
     ]
    ],
    [
     "Objective",
     [
      "OAE: outer hair cells, screening",
      "ABR I–V prolonged = retrocochlear",
      "OAE present + ABR absent = neuropathy"
     ]
    ]
   ]
  },
