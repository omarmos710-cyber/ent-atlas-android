    ],
    [
     "Tests",
     [
      "Rinne negative 256 → 512 → 1024 Hz",
      "Carhart notch: bone dip ~15 dB at 2 kHz",
      "As tympanogram, absent reflexes"
     ]
    ],
    [
     "Treat",
     [
      "hearing aid offered to all first",
      "stapedotomy closes gap in ~90%",
      "dead ear 0.5–1%"
     ]
    ],
    [
     "Never operate",
     [
      "only or better-hearing ear",
      "active Ménière's · divers, pilots"
     ]
    ]
   ]
