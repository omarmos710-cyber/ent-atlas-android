     [
      "nosebleeds · telangiectasias",
      "visceral AVMs · first-degree relative",
      "three = definite, two = possible"
     ]
    ],
    [
     "Screen",
     [
      "bubble echo: lung AVMs (~30%)",
      "lung AVM → stroke, brain abscess",
      "MRI brain for cerebral AVMs"
     ]
    ],
    [
     "Treat the nose",
     [
      "moisturise · tranexamic acid · iron",
      "KTP/argon laser to each lesion",
      "IV bevacizumab if severe",
      "topical bevacizumab: no benefit"
     ]
    ],
    [
     "Refractory",
     [
      "septodermoplasty halves laser sessions",
      "Young's: close the nostrils"
     ]
    ],
    [
     "Never",
     [
      "repeated packing or wide cautery"
     ]
