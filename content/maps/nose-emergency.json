     ]
    ],
    [
     "First aid",
     [
      "sit up, lean forward (Trotter)",
      "pinch soft nose ≥ five minutes",
      "pulse, pressure, IV access, bloods"
     ]
    ],
    [
     "Cautery",
     [
      "bipolar fails less than silver nitrate",
      "one side of the septum only"
     ]
    ],
    [
     "Packing",
     [
      "resorbable if anticoagulated",
      "posterior pack: admit, fails in a third",
      "Foley 12–14 F, saline not air"
     ]
    ],
    [
     "Surgery",
     [
      "TESPAL: control 95–98%",
      "crista ethmoidalis = landmark",
      "above middle turbinate → ethmoidal ligation",
      "embolisation ~88%, can't reach ethmoidals"
     ]
    ],
    [
     "Red flags",
     [
      "teenage boy, unilateral → angiofibroma",
      "late massive bleed → ICA pseudoaneurysm"
     ]
    ]
   ]
