    [
     "Diagnose",
     [
      "flexible nasendoscopy = best view",
      "lateral X-ray: crying exaggerates size",
      "size relative to the nasopharynx",
      "adult mass → biopsy for NPC"
     ]
    ],
    [
     "Treat",
